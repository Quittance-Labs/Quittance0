# MVP backend — no database. Copy to .env for local, or set in Render/Railway.

PORT=3001
NODE_ENV=production

# --- Stellar Network (Validated by /api/ready) ---
# Readiness fails fast with 503 if STELLAR_NETWORK is not TESTNET or PUBLIC,
# or if STELLAR_HORIZON_URL does not use HTTPS in production.
STELLAR_NETWORK=TESTNET
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org

# Optional: Enable lightweight Horizon reachability check on readiness probes.
# Default: false (off for demo deploys so external latency does not trigger false negatives)
HEALTH_HORIZON_PING=false

# Optional placeholders (MVP uses per-invoice sellerPublicKey from the wallet)
SELLER_PUBLIC_KEY=
SELLER_SECRET_KEY=

PAYMENT_MONITOR_POLL_MS=5000
# Set this when enabling a fixed-wallet monitor in an MVP deployment.
# PAYMENT_MONITOR_CURSOR_FILE=.data/payment-monitor-cursors.json

# --- Frontend CORS & Deploy Gating (Validated by /api/ready) ---
# Must match the deployed frontend origin (CORS), no trailing slash.
# Readiness returns 503 in production if no frontend origin is configured.
# Liveness (/api/health) returns 200 regardless to prevent cold-start restart loops.
# Local:  http://localhost:3000
# Prod:   https://YOUR-APP.vercel.app
FRONTEND_URL=http://localhost:3000

# Optional exact origins separated by commas, e.g. a preview and custom domain.
# Wildcards are intentionally unsupported.
FRONTEND_URLS=

# Local testing only. Production code forces this false even if misconfigured.
# Readiness fails fast with 503 if set to true in production.
ALLOW_SIMULATE=false

# --- Abuse Controls ---

# Invoice ceiling for MVP in-memory mode. Once reached, new creates return 503.
# Default: 5000
INVOICE_CEILING=5000

# Require cryptographic signatures for sensitive operations (cancel).
# Production always requires signatures. Set to 'true' to test locally.
# Default: false (dev), true (production)
REQUIRE_SIGNATURES=false

# Redis connection for rate limiting and caching (optional).
# Falls back to in-memory storage if not configured.
REDIS_URL=
